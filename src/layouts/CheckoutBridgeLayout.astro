---
import '@/styles/starwind.css';
import {
  absoluteAssetUrl,
  canonicalUrl,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
} from '../config/seo';
import { FAVICON_VERSION } from '../config/site';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  logoAlt?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, logoAlt, ogImage, ogImageAlt, jsonLd } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname, Astro.url.origin);
const ogImageUrl = absoluteAssetUrl(ogImage ?? DEFAULT_OG_IMAGE);
const shareImageAlt = ogImageAlt ?? title;

const navLinks = [
  { href: '/', label: 'cheatsrust.net home' },
  { href: '/products/rust/', label: 'Browse Rust product catalog' },
  { href: '/blog/', label: 'Read Rust setup guides' },
  { href: '/faq/', label: 'Pre-purchase FAQ' },
  { href: '/support/', label: 'Checkout support desk' },
  { href: '/forum/', label: 'Rust community forum' },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="en-US" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${FAVICON_VERSION}`} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <header class="border-b border-border bg-muted/20">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-5 py-4">
        <a href="/" class="inline-flex items-center gap-2 font-bold">
          <img src="/logo.svg" width="32" height="32" alt={logoAlt ?? 'Rust Cheats logo'} />
          <span class="text-sm">Rust Cheats checkout</span>
        </a>
        <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Checkout bridge">
          {navLinks.map((link) => (
            <a href={link.href} class="text-muted-foreground hover:text-primary">
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content" class="mx-auto max-w-4xl px-5 py-10">
      <slot />
    </main>
    <footer class="border-t border-border py-8 text-center text-sm text-muted-foreground">
      <p>
        Partner checkout on ZADEYO ·{' '}
        <a href="/privacy/" class="hover:text-primary">Checkout privacy policy</a> ·{' '}
        <a href="/terms/" class="hover:text-primary">Checkout terms of use</a>
      </p>
    </footer>
  </body>
</html>
